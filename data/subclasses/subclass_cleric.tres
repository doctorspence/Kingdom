[resource]
script = ExtResource("1_sub")
id = &"subclass_cleric"
display_name = "Cleric"
primary_class = &"class_lamplighter"
tagline = "The Healer"
identity = "Healing, cleansing and blessings. Early on the Cleric works with herbs, bandages and remedies; the powerful magical healing comes later, and comes with a price list nobody reads."
weapon_specialties = "Staves, maces, ritual lanterns"
progression_direction = "From remedies to miracles: wider cleanses, heals that must be aimed and predicted, and sanctuaries where friends can catch their breath."
abilities = Array[ExtResource("2_ability")]([SubResource("A_snuff"), SubResource("A_beacon"), SubResource("A_pyre")])
passive_name = "Patient Hands"
passive_description = "Mend heals 15% more, and Mana comes back 25% faster."
passive_mods = {
"mend_heal_mult": 1.15,
"oil_regen_mult": 1.25
}
planned_abilities = "Blessings (timed buffs), Vigil Lantern (a healing circle), a revive that costs no flask."
available = true
faction = &"faction_white_knights"
initiation_title = "A Rite of Healing"
initiation_story = "Tend the dying through one long night, or perform a rite at a shrine. The Order will gladly take credit. It will also ask for a donation."
