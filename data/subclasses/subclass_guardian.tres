[resource]
script = ExtResource("1_sub")
id = &"subclass_guardian"
display_name = "Guardian"
primary_class = &"class_bulwark"
tagline = "The Shieldbearer"
identity = "Blocking, taunting and counters, with the highest defense in the land. The Guardian stands where the line would be, and then becomes the line."
weapon_specialties = "Sword and shield, tower shields, maces"
progression_direction = "Protecting allies: wider taunts, stronger cover, and ways to survive the thing that should have killed you."
abilities = Array[ExtResource("2_ability")]([SubResource("A_bellow"), SubResource("A_hold"), SubResource("A_unbroken")])
passive_name = "Wall of One"
passive_description = "Blocking costs another 10% less stamina, and +10 armor."
passive_mods = {
"block_stamina_mult": 0.9,
"armor_add": 10.0
}
planned_abilities = "Bodyguard (cover the ally your target was attacking), tower-shield stances, counter-bashes."
available = true
faction = &"faction_white_knights"
initiation_title = "The Overwhelming Assault"
initiation_story = "Defend a settlement, or survive an assault no sane person would try. The White Knights notice the ones who stay. They do not mention that they were also the ones who left."
