[resource]
script = ExtResource("1_sub")
id = &"subclass_warrior"
display_name = "Warrior"
tagline = "The Weaponmaster"
identity = "Heavy physical damage and weapon combos. The Warrior learns one weapon the way other people learn a grudge, and then another, and then both at once. Parries, counters and blows that end arguments."
weapon_specialties = "Greatswords, axes, longswords, dual weapons"
progression_direction = "More and harder-hitting combos, bigger sweeps, and ways to turn a lost exchange into a won one. Stays a pure fighter all game."
abilities = Array[ExtResource("2_ability")]([SubResource("A_cleave"), SubResource("A_feint"), SubResource("A_mist")])
passive_name = "Weaponmaster"
passive_description = "Heavy attacks deal 10% more damage."
passive_mods = {
"heavy_damage_mult": 1.1
}
planned_abilities = "Dual-weapon stances, counter-strikes after a parry, weapon-specific finishers."
available = true
initiation_title = "A Trial of Arms"
initiation_story = "Beat a formidable opponent, in a ring or on a road. Nobody keeps score except the loser, who usually can't."
