unlock_level = 4
cooldown = 8.0
cost = 25.0
icon_color = Color(0.5, 0.85, 0.5, 1)
cast_anim = &"Spell_Simple_Enter"
power = 40.0
ability_range = 12.0

[sub_resource type="Resource" id="A_hex"]
