[resource]
script = ExtResource("1_class")
id = &"class_lamplighter"
display_name = "Lamplighter"
role = "Healer"
description = "Keeper of the old shrine-flames. Lobs embers that heal friends (and can miss), throws lanterns and smoke, and still swings a mean staff."
weapon = ExtResource("5_weapon")
resource_kind = 1
resource_label = "Oil"
resource_color = Color(0.95, 0.65, 0.25, 1)
strength = 7.0
strength_per_level = 0.4
agility = 8.0
agility_per_level = 0.5
intellect = 15.0
intellect_per_level = 1.4
vitality = 10.0
vitality_per_level = 0.9
armor = 10.0
armor_per_level = 0.8
passive_name = "Keeper of the Flame"
passive_description = "Revives take half as long. Healing grows with Intellect. Your heals work at 50% on yourself. Oil trickles back, faster when you land hits."
passive_mods = {"revive_time_mult": 0.5, "self_heal_mult": 0.5}
abilities = Array[ExtResource("2_ability")]([SubResource("A_kindle"), SubResource("A_vigil"), SubResource("A_snuff"), SubResource("A_flare"), SubResource("A_beacon"), SubResource("A_pyre")])
talents = Array[ExtResource("3_talent")]([SubResource("T_wick"), SubResource("T_bright"), SubResource("T_reservoir"), SubResource("T_steady"), SubResource("T_tallow"), SubResource("T_oil"), SubResource("T_clean_air"), SubResource("T_blinding"), SubResource("T_quick_beacon"), SubResource("T_warmth"), SubResource("T_self"), SubResource("T_rain")])
