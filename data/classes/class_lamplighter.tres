[resource]
script = ExtResource("1_class")
id = &"class_lamplighter"
display_name = "Mystic"
role = "Magic and healing"
description = "A quiet practitioner of the old arts, rare and mistrusted. Channels waves of arcane force, mends wounds and lays curses on the strongest foe. Knows Arcane Surge from the start, learns Mend at level 4 and Hex at 6. Chooses a path at level 10 (later)."
weapon = ExtResource("5_weapon")
starting_items = Array[ExtResource("9_item")]([ExtResource("50_start"), ExtResource("51_start"), ExtResource("52_start")])
resource_kind = 1
resource_label = "Mana"
resource_color = Color(0.22, 0.46, 0.95, 1)
strength = 7.0
strength_per_level = 0.4
agility = 8.0
agility_per_level = 0.5
intellect = 15.0
intellect_per_level = 1.4
vitality_per_level = 0.9
armor_per_level = 0.8
passive_name = "Keeper of the Flame"
passive_description = "Revives take half as long. Spell power and healing grow with Intellect. Mana trickles back, faster when you land melee hits."
passive_mods = {
"revive_time_mult": 0.5
}
abilities = Array[ExtResource("2_ability")]([SubResource("A_bolt"), SubResource("A_mend"), SubResource("A_hex")])
