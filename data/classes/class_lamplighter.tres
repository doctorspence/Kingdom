[sub_resource type="Resource" id="A_bolt"]
script = ExtResource("2_ability")
id = &"ability_arcane_bolt"
display_name = "Arcane Surge"
description = "Gather power in both hands for a moment, then loose a wave of arcane force that rolls 36 m ahead, starting 6 m wide and spreading wider as it goes. It passes through and hits up to 3 enemies (the first hardest) and is stopped by walls. Deals 15% more to Hexed enemies. Mana and cooldown are only spent when it fires; being hit, guard-broken or rolling cancels it for free."
kind = 22
unlock_level = 1
cooldown = 4.0
cost = 20.0
icon_color = Color(0.55, 0.7, 1, 1)
cast_anim = &"cut/Arcane_Surge"
cast_time = 0.333
lock_time = 0.483
power = 55.0
radius = 6.0
ability_range = 36.0
value = 35.0
max_targets = 3
hexed_bonus = 0.15
pay_on_release = true
spread = 0.2
cast_anim_speed = 3.0

[sub_resource type="Resource" id="A_mend"]
script = ExtResource("2_ability")
id = &"ability_mend"
display_name = "Mend"
description = "Heal the friend you are facing (within 12 m), or yourself if no friend is in front of you."
